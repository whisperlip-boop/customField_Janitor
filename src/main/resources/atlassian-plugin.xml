<atlassian-plugin key="${atlassian.plugin.key}" name="${project.name}" plugins-version="2">
    <plugin-info>
        <description>${project.description}</description>
        <version>${project.version}</version>
        <vendor name="${project.organization.name}" url="${project.organization.url}" />
        <!-- UPM은 SVG를 주면 0바이트를 서빙한다(실측). 반드시 래스터 이미지여야 한다. -->
        <param name="plugin-icon">images/search.png</param>
        <param name="plugin-logo">images/search.png</param>
    </plugin-info>

    <!-- 기획서 결정 6: 이 플러그인은 "도구 함"이다. 지금은 fields 모듈만 있고
         나중에 users 모듈(기존 inactive 계정 검색 앱)이 여기로 합쳐진다.
         그래서 모듈 key는 fields- 접두사로 네이밍한다. -->

    <resource type="i18n" name="i18n" location="janitor"/>

    <!-- 목록/상세 화면.

         URL을 /secure/admin/ 아래에 두는 이유: 관리 화면 데코레이터가 붙고
         roles-required="admin"으로 액션 진입이 막힌다.

         주의: 이 경로에 있다고 웹수도가 자동으로 걸리지는 않는다(실측 — 로그인만 한
         세션으로 화면이 그대로 열렸다). 웹수도는 액션 클래스의 @WebSudoRequired가
         담당한다. 그리고 그것과 별개로 액션 안에서 GlobalPermissionManager로 권한을
         다시 검사한다(기획서 7.2 / 함정 1). -->
    <webwork1 key="fields-usage-actions" name="Field Usage Actions" class="java.lang.Object">
        <description>Custom field usage list and detail screens</description>
        <actions>
            <action name="com.bskim.jira.janitor.fields.web.CustomFieldUsageAction"
                    alias="CustomFieldUsage"
                    roles-required="admin">
                <view name="success">/templates/janitor/fields/list.vm</view>
                <view name="detail">/templates/janitor/fields/detail.vm</view>
                <view name="securitybreach">/secure/views/securitybreach.jsp</view>
            </action>

            <!-- 사용 설명서. 목록 화면 안내 문구 아래 링크로 들어온다.
                 별도 액션으로 두는 이유: 관리 화면 데코레이터·i18n·권한 검사를
                 목록/상세 화면과 똑같이 받는다. 정적 HTML 리소스로 두면 그 셋을
                 전부 잃는다(로그인 안 한 사람도 열리고, 한국어/영어 전환도 안 된다). -->
            <action name="com.bskim.jira.janitor.fields.web.CustomFieldUsageHelpAction"
                    alias="CustomFieldUsageHelp"
                    roles-required="admin">
                <view name="success">/templates/janitor/fields/help.vm</view>
                <view name="securitybreach">/secure/views/securitybreach.jsp</view>
            </action>
        </actions>
    </webwork1>

    <!-- 관리 메뉴 항목. "필드" 그룹의 Custom fields / Field configurations /
         Field configuration schemes 아래에 붙는다.

         section 값은 실측이다. Jira 설치본의
         WEB-INF/classes/webfragment/system-admin-sections.xml 에서
         view_custom_fields web-item이 쓰는 값을 그대로 복사했다:

             <web-section key="element_options_section" location="admin_issues_menu"/>
             <web-section key="fields_section" location="element_options_section"/>
             <web-item key="view_custom_fields" section="element_options_section/fields_section"/>

         즉 section에는 admin_issues_menu 접두사를 붙이지 않는다. 기획서 기대값
         (admin_issues_menu/fields_section)과 JSP의 admin.active.section 메타값
         (admin_issues_menu/element_options_section/fields_section) 둘 다 여기서는
         동작하지 않는다 — 붙이면 메뉴가 조용히 안 나온다(실측).
         자세한 내용은 docs/00-환경실측.md [확인 4].

         weight 80은 기존 3개(10/20/30) 뒤에 놓기 위한 값이다.

         condition은 메뉴를 숨기는 용도일 뿐 접근 제어가 아니다. 실제 차단은
         액션/REST의 서버측 검사가 한다(기획서 7.2 / 함정 1). -->
    <web-item key="fields-usage-admin-link"
              section="element_options_section/fields_section"
              weight="80">
        <label key="janitor.fields.menu.label"/>
        <tooltip key="janitor.fields.menu.tooltip"/>
        <link linkId="cf-usage-link">/secure/admin/CustomFieldUsage.jspa</link>
        <condition class="com.bskim.jira.janitor.fields.web.AdminOnlyCondition"/>
    </web-item>

    <!-- 기획서 6.3: 기존 커스텀 필드 관리 화면에 사용 현황을 주입한다.

         atl.admin 컨텍스트는 모든 관리 화면에 실린다. 그래서 JS가 첫 줄에서
         URL을 보고 대상이 아니면 즉시 물러난다 — 비용은 정규식 한 번이다.
         AUI 의존성을 선언하지 않는 이유: lozenge CSS는 관리 화면에 이미 실려 있고
         (커스텀 필드 표 자체가 locked/managed lozenge를 쓴다),
         없는 web-resource 키를 선언하면 모듈 로딩이 깨진다. -->
    <web-resource key="fields-usage-inject" name="Custom fields page usage badges">
        <context>atl.admin</context>
        <resource type="download" name="janitor-inject.js" location="js/inject.js"/>
        <resource type="download" name="janitor-inject.css" location="css/inject.css"/>
    </web-resource>

    <rest key="janitor-rest" path="/janitor" version="1.0">
        <description>Custom Field Janitor REST resources</description>
    </rest>

</atlassian-plugin>
