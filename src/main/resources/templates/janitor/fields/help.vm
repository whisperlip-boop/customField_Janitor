           스크롤을 따라오는 색인이 맞다. 좁은 화면에서는 색인을 본문 위로 올린다. */
        .janitor-help-layout { display: flex; align-items: flex-start; gap: 28px; }
        .janitor-help-body { flex: 1 1 auto; min-width: 0; max-width: 900px; }
        .janitor-help-toc {
            flex: 0 0 260px;
            position: -webkit-sticky;
            position: sticky;
            top: 16px;
            max-height: calc(100vh - 48px);
            overflow-y: auto;
            border-left: 2px solid #dfe1e6;
            padding: 4px 0 4px 14px;
        }
        .janitor-help-toc h3 { margin: 0 0 8px; font-size: 12px; text-transform: uppercase; color: #6b778c; }
        .janitor-help-toc ul { list-style: none; margin: 0; padding: 0; }
        .janitor-help-toc li { margin: 0; }
        .janitor-help-toc a {
            display: block; padding: 4px 6px; border-radius: 3px;
            color: #0052cc; text-decoration: none; font-size: 13px; line-height: 1.4;
        }
        .janitor-help-toc a:hover { background: #f4f5f7; text-decoration: none; }
        .janitor-help-toc .janitor-toc-h3 a { padding-left: 18px; font-size: 12px; color: #42526e; }
        .janitor-help-toc a.janitor-toc-active { background: #deebff; color: #0747a6; font-weight: bold; }

        @media (max-width: 1100px) {
            .janitor-help-layout { display: block; }
            .janitor-help-toc {
                position: static; max-height: none; border-left: 0;
                border-bottom: 2px solid #dfe1e6; padding: 0 0 12px; margin-bottom: 18px;
            }
            .janitor-help-toc ul { column-count: 2; column-gap: 24px; }
        }

        /* 언어 토글 */
        .janitor-lang { display: inline-flex; border: 1px solid #c1c7d0; border-radius: 3px; overflow: hidden; }
        .janitor-lang a { padding: 4px 12px; font-size: 13px; text-decoration: none; color: #42526e; background: #fff; }
        .janitor-lang a:hover { background: #f4f5f7; text-decoration: none; }
        .janitor-lang a.janitor-lang-on { background: #0052cc; color: #fff; font-weight: bold; }
        .janitor-lang a + a { border-left: 1px solid #c1c7d0; }

        /* 본문 */
        .janitor-help-body h2 {
            margin-top: 34px; padding-top: 14px; border-top: 2px solid #dfe1e6;
            scroll-margin-top: 12px;
        }
        .janitor-help-body h3 { margin-top: 22px; scroll-margin-top: 12px; }
        .janitor-help-body table { width: 100%; margin: 10px 0 18px; }
        .janitor-help-body td, .janitor-help-body th { vertical-align: top; }
        .janitor-w1 { width: 22%; white-space: nowrap; }
        .janitor-w2 { width: 26%; }
        .janitor-help-body dl { margin: 0; }
        .janitor-help-body dt { font-weight: bold; margin-top: 12px; }
        .janitor-help-body dd { margin: 2px 0 0 0; color: #42526e; }
        .janitor-meta { color: #6b778c; font-size: 12px; }
        .janitor-help-body code { background: #f4f5f7; padding: 1px 4px; border-radius: 3px; font-size: 12px; }
        .janitor-safe   { border-left: 4px solid #00875a; padding-left: 14px; }
        .janitor-check  { border-left: 4px solid #ff991f; padding-left: 14px; }
        .janitor-danger { border-left: 4px solid #de350b; padding-left: 14px; }
    </style>
