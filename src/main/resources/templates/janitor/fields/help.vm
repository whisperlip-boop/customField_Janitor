<script type="text/javascript">
(function () {
    "use strict";

    var body = document.querySelector(".janitor-help-body");
    var list = document.getElementById("janitor-toc-list");
    if (!body || !list) { return; }

    var headings = Array.prototype.slice.call(body.querySelectorAll("h2, h3"));
    if (!headings.length) {
        document.getElementById("janitor-toc").style.display = "none";
        return;
    }

    var links = [];
    headings.forEach(function (heading, index) {
        if (!heading.id) { heading.id = "janitor-s" + index; }

        var li = document.createElement("li");
        if (heading.tagName === "H3") { li.className = "janitor-toc-h3"; }

        var a = document.createElement("a");
        a.href = "#" + heading.id;
        a.textContent = (heading.textContent || "").trim();
        a.title = a.textContent;
        li.appendChild(a);
        list.appendChild(li);
        links.push({ link: a, heading: heading });
    });

    function activate(entry) {
        links.forEach(function (item) {
            if (item === entry) {
                item.link.className += item.link.className ? " janitor-toc-active" : "janitor-toc-active";
            } else {
                item.link.className = item.link.className.replace(/\s*janitor-toc-active/g, "");
            }
        });
    }

    // 스크롤 위치에 맞춰 색인 항목을 강조한다. IntersectionObserver 가 없으면
    // 색인은 그대로 쓰이고 강조만 빠진다.
    if (typeof IntersectionObserver === "function") {
        var visible = [];
        var observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
                var idx = visible.indexOf(e.target);
                if (e.isIntersecting && idx < 0) { visible.push(e.target); }
                if (!e.isIntersecting && idx >= 0) { visible.splice(idx, 1); }
            });
            if (!visible.length) { return; }
            // 문서 순서상 가장 위에 있는 것을 현재 위치로 본다.
            var top = visible.slice().sort(function (a, b) {
                return headings.indexOf(a) - headings.indexOf(b);
            })[0];
            for (var i = 0; i < links.length; i++) {
                if (links[i].heading === top) { activate(links[i]); break; }
            }
        }, { rootMargin: "0px 0px -70% 0px" });
        headings.forEach(function (h) { observer.observe(h); });
    }

    // 색인을 눌러 이동했을 때는 즉시 강조를 옮긴다.
    links.forEach(function (item) {
        item.link.addEventListener("click", function () { activate(item); });
    });
})();
</script>

