#* 목록 화면 — 기획서 6.1 "필드 사용 현황"

   decorator/meta 두 줄은 실측값이다(docs/00-환경실측.md [확인 4]).
   Jira 8.13의 커스텀 필드 화면이 쓰는 것과 같은 값을 넣어 관리 사이드바에서
   "필드" 그룹이 열린 상태로 유지된다. *#
<html>
<head>
    <title>$action.text("janitor.fields.page.title")</title>
    <meta name="decorator" content="admin">
    <meta name="admin.active.section" content="admin_issues_menu/element_options_section/fields_section">
    <meta name="admin.active.tab" content="cf-usage-link">
    <style type="text/css">
        /* 심층 스캔은 성격이 다른 기능이다. 선 하나로 떼어 놓아 "표의 일부"로
           읽히지 않게 한다 — 여기 결과는 라벨에 반영되지 않는다. */
        .janitor-deep { margin-top: 32px; padding-top: 16px; border-top: 2px solid #dfe1e6; }

        .janitor-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 10px 0 16px; }
        .janitor-toolbar .janitor-spacer { flex: 1 1 auto; }
        .janitor-meta { color: #707070; font-size: 12px; }
        /* 표 안의 "-" / "부정확" / "확인 불가" 는 날짜·숫자와 같은 크기로 둔다.
           janitor-meta(12px)를 쓰면 같은 컬럼에서 글자 크기가 달라져 어긋나 보인다. */
        .janitor-cellnote { color: #6b778c; }
        .janitor-cellwarn { color: #974f0c; }
        .janitor-note { margin: 0 0 16px; }
        .janitor-help-link { white-space: nowrap; }
        .janitor-lang { display: inline-flex; border: 1px solid #c1c7d0; border-radius: 3px; overflow: hidden; }
        .janitor-lang a { padding: 4px 12px; font-size: 13px; text-decoration: none; color: #42526e; background: #fff; }
        .janitor-lang a:hover { background: #f4f5f7; text-decoration: none; }
        .janitor-lang a.janitor-lang-on { background: #0052cc; color: #fff; font-weight: bold; }
        .janitor-lang a + a { border-left: 1px solid #c1c7d0; }
        .janitor-filters { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 12px; }
        .janitor-filters input[type=text] { width: 260px; }
        table.janitor-table { width: 100%; }
        table.janitor-table th { white-space: nowrap; cursor: pointer; }
        table.janitor-table th.janitor-nosort { cursor: default; }
        table.janitor-table td.janitor-num, table.janitor-table th.janitor-num { text-align: right; }
        .janitor-fieldid { color: #707070; font-size: 12px; }
        .janitor-dup { color: #bf2600; font-weight: bold; }
        .janitor-progress { margin: 10px 0; }
        .janitor-empty { padding: 24px; text-align: center; color: #707070; }
    </style>
</head>
<body>

<div class="aui-page-header">
    <div class="aui-page-header-inner">
        <div class="aui-page-header-main">
            <h2>$action.text("janitor.fields.page.title")</h2>
        </div>
        <div class="aui-page-header-actions">
            #* 언어는 서버측에서 정해진다(LocaleText). 링크로 공유하면 받는 사람도 같은 언어로 본다. *#
            <div class="janitor-lang">
                <a href="$action.koUrl" #if($action.korean)class="janitor-lang-on"#end>한국어</a>
                <a href="$action.enUrl" #if(!$action.korean)class="janitor-lang-on"#end>English</a>
            </div>
        </div>
    </div>
</div>

#* hasAnyErrors() 다. hasErrorMessages() 는 webwork1 에 없다 —
   실제 이름은 getHasErrorMessages() 이고, Velocity 는 메서드 호출 문법에서 그걸
   찾지 못해 조용히 false 로 평가한다. 그래서 v1.0.1 까지 이 안내가 한 번도
   화면에 나오지 않았다(실측). 없는 필드 ID로 들어온 관리자는 아무 설명 없이
   목록만 봤다. *#
#if ($action.hasAnyErrors())
    <div class="aui-message aui-message-warning">
        #foreach ($message in $action.errorMessages)
            <p>$action.escape($message)</p>
        #end
    </div>
#end

<p class="janitor-note">
    $action.text("janitor.fields.page.intro")
    <a href="$action.helpUrl" class="janitor-help-link">$action.text("janitor.fields.page.helpLink")</a>
</p>

<div class="aui-message aui-message-info janitor-note">
    <p>$action.text("janitor.fields.limitation")</p>
    <p>$action.text("janitor.fields.metric.note")</p>
</div>

<div class="janitor-toolbar">
    <button id="janitor-scan" class="aui-button aui-button-primary">$action.text("janitor.fields.action.scanNow")</button>
    <span class="janitor-spacer"></span>
    #if ($action.scanned)
        <span class="janitor-meta">
            $action.text("janitor.fields.lastScan"): $action.lastScanAt
            (${action.lastScanDurationMs} ms)
        </span>
        <a class="aui-button" href="${action.restBase}/fields.csv">$action.text("janitor.fields.action.csv")</a>
    #end
</div>

<div id="janitor-progress" class="janitor-progress" style="display:none;">
    #* 클래스를 JS가 상태에 따라 바꾼다. 실패한 순간에 파란 정보 박스로 보이면
       가장 중요한 순간에 색이 반대다. *#
    <div id="janitor-progress-box" class="aui-message aui-message-info">
        <p id="janitor-progress-text"></p>
    </div>
</div>

#* 실패는 새로고침에도 남아야 한다. 진행률만 쓰면 화면을 다시 그리는 순간 사라지고
   이전 스캔의 표와 시각만 남아서, 관리자가 낡은 결과를 방금 것으로 믿는다. *#
#if ($action.scanFailure)
    <div class="aui-message aui-message-error">
        <p class="title"><strong>$action.text("janitor.fields.scanFailed.title")</strong></p>
        <p>$action.escape($action.scanFailure)</p>
        <p>$action.text("janitor.fields.scanFailed.at") $action.scanFailureAt</p>
        #if ($action.resultStale)
            <p><strong>$action.text("janitor.fields.scanFailed.stale")</strong></p>
        #end
    </div>
#end

#* 목록이 반쪽인 것은 "일부 항목을 못 읽었다"와 성격이 다르다. 아래 "확인 불가"
   목록에 한 줄로 두면 표가 완전하다고 읽힌다. *#
#if ($action.fieldListDegraded)
    <div class="aui-message aui-message-warning">
        <p class="title"><strong>$action.text("janitor.fields.degraded.title")</strong></p>
        <p>$action.text("janitor.fields.degraded.body")</p>
    </div>
#end

#if (!$action.scanned)
    <div class="aui-message aui-message-info">
        <p>$action.text("janitor.fields.empty.neverScanned")</p>
        <p>$action.text("janitor.fields.empty.largeInstance")</p>
    </div>
#else

<div class="janitor-filters">
    <label for="janitor-search">$action.text("janitor.fields.filter.search")</label>
    <input type="text" id="janitor-search" class="text"
           placeholder="$action.text('janitor.fields.filter.searchPlaceholder')">

    <label for="janitor-status">$action.text("janitor.fields.filter.status")</label>
    <select id="janitor-status" class="select">
        <option value="">$action.text("janitor.fields.filter.all")</option>
        <option value="unused">$action.text("janitor.fields.status.unused")</option>
        <option value="abandoned">$action.text("janitor.fields.status.abandoned")</option>
        <option value="orphan-data">$action.text("janitor.fields.status.orphanData")</option>
        <option value="active">$action.text("janitor.fields.status.active")</option>
        <option value="at-risk">$action.text("janitor.fields.status.atRisk")</option>
    </select>

    <label for="janitor-type">$action.text("janitor.fields.filter.type")</label>
    #* 입력 필드였을 때는 관리자가 타입 이름을 정확히 알아야 했다. 스캔 결과에 실제로
       있는 타입만 드롭다운으로 낸다 — 고른 값은 반드시 결과가 있다. *#
    <select id="janitor-type" class="select">
        <option value="">$action.text("janitor.fields.filter.all")</option>
        #foreach ($type in $action.fieldTypes)
            <option value="$action.escape($type)">$action.escape($type)</option>
        #end
    </select>

    <span class="janitor-meta" id="janitor-count"></span>
</div>

<table class="aui aui-table-interactive janitor-table" id="janitor-fields">
    <thead>
    <tr>
        <th data-sort="status">$action.text("janitor.fields.column.status")</th>
        <th data-sort="name">$action.text("janitor.fields.column.name")</th>
        <th data-sort="type">$action.text("janitor.fields.column.type")</th>
        <th class="janitor-num" data-sort="issues">$action.text("janitor.fields.column.issuesWithValue")</th>
        <th class="janitor-num" data-sort="rows">$action.text("janitor.fields.column.valueRows")</th>
        <th data-sort="lastchange">$action.text("janitor.fields.column.lastChange")</th>
        <th class="janitor-num" data-sort="screens">$action.text("janitor.fields.column.screens")</th>
        <th class="janitor-num" data-sort="workflows">$action.text("janitor.fields.column.workflows")</th>
        <th class="janitor-num" data-sort="filters">$action.text("janitor.fields.column.filters")</th>
        <th class="janitor-num" data-sort="gadgets">$action.text("janitor.fields.column.gadgets")</th>
        <th class="janitor-num" data-sort="total">$action.text("janitor.fields.column.totalReferences")</th>
    </tr>
    </thead>
    <tbody>
    #foreach ($field in $action.fields)
        #set ($status = $field.status)
        <tr data-status="$status.code"
            data-name="$action.escape($field.name)"
            data-type="$action.escape($field.typeName)"
            data-fieldid="$field.fieldId">
            <td data-sort-value="$status.cleanupOrder">
                #if ($status.lozengeType == "")
                    <span class="aui-lozenge">$action.text($status.i18nKey)</span>
                #else
                    <span class="aui-lozenge aui-lozenge-${status.lozengeType}">$action.text($status.i18nKey)</span>
                #end
            </td>
            <td>
                <a href="$action.detailUrl($field)">$action.escape($field.name)</a>
                #if ($field.locked)
                    <span class="aui-lozenge aui-lozenge-error"
                          title="$action.text('janitor.fields.locked')">$action.text("janitor.fields.lockedShort")</span>
                #end
                #if ($field.duplicateName)
                    <span class="janitor-dup" title="$action.text('janitor.fields.duplicateName')">&#9888;</span>
                #end
                <div class="janitor-fieldid">$field.fieldId</div>
            </td>
            <td>
                $action.escape($field.typeName)
                #if (!$field.typeAvailable)
                    <div class="janitor-dup" title="$action.text('janitor.fields.typeUnavailable')">$action.text("janitor.fields.typeUnavailableShort")</div>
                #end
            </td>
            <td class="janitor-num" data-sort-value="$field.issuesWithValue">
                $field.issuesWithValue
            </td>
            <td class="janitor-num" data-sort-value="$field.valueRows">$field.valueRows</td>
            <td>
                #if ($field.lastValueChangeAmbiguous)
                    <span class="janitor-cellwarn"
                          title="$action.text('janitor.fields.duplicateName')">$action.text("janitor.fields.inaccurate")</span>
                #elseif ($field.lastValueChange)
                    $action.formatDay($field.lastValueChange)
                #else
                    <span class="janitor-cellnote">-</span>
                #end
            </td>
            <td class="janitor-num" data-sort-value="$field.getRefCount('SCREEN')">$field.getRefCount('SCREEN')</td>
            <td class="janitor-num" data-sort-value="$field.getRefCount('WORKFLOW')">$field.getRefCount('WORKFLOW')</td>
            <td class="janitor-num" data-sort-value="$field.getRefCount('FILTER')">$field.getRefCount('FILTER')</td>
            <td class="janitor-num" data-sort-value="$field.getRefCount('GADGET')">$field.getRefCount('GADGET')</td>
            <td class="janitor-num" data-sort-value="$field.totalReferenceCount">$field.totalReferenceCount</td>
        </tr>
    #end
    </tbody>
</table>

#if ($action.problems.size() > 0)
    <h3>$action.text("janitor.fields.problems.title") ($action.problems.size())</h3>
    <p class="janitor-meta">$action.text("janitor.fields.problems.intro")</p>
    <table class="aui">
        <thead>
        <tr>
            <th>$action.text("janitor.fields.problems.area")</th>
            <th>$action.text("janitor.fields.problems.target")</th>
            <th>$action.text("janitor.fields.problems.message")</th>
        </tr>
        </thead>
        <tbody>
        #foreach ($problem in $action.problems)
            <tr>
                <td>$action.escape($problem.area)</td>
                <td>$action.escape($problem.target)</td>
                <td>$action.escape($problem.message)</td>
            </tr>
        #end
        </tbody>
    </table>
#end

#end

#* 심층 스캔. 일반 스캔과 따로 두는 이유는 성격이 다르기 때문이다 — 여기서 나오는
   것은 참조가 아니라 문자열 일치이고, 비용도 훨씬 크다. 그래서 버튼도 설명도
   결과도 별도 구역에 둔다. *#
<div class="janitor-deep">
    <h3>$action.text("janitor.fields.deep.title")</h3>
    <p>$action.text("janitor.fields.deep.intro")</p>
    <p class="janitor-meta">$action.text("janitor.fields.deep.cost")</p>

    <div class="janitor-toolbar">
        <button id="janitor-deep-scan" class="aui-button">$action.text("janitor.fields.deep.action")</button>
        <span class="janitor-spacer"></span>
        #if ($action.deepResultAvailable)
            <span class="janitor-meta">
                $action.text("janitor.fields.deep.lastScan"): $action.deepScanAt
            </span>
        #end
    </div>

    <div id="janitor-deep-progress" class="janitor-progress" style="display:none;">
        <div id="janitor-deep-progress-box" class="aui-message aui-message-info">
            <p id="janitor-deep-progress-text"></p>
        </div>
    </div>

    #* 심층 스캔의 실패도 새로고침과 재기동을 넘어 남는다. 진행률만 쓰면 실패한
       다음에 옛 결과만 남아 방금 것으로 읽힌다(일반 스캔에서 두 번 고친 모양). *#
    #if ($action.deepFailure)
        <div class="aui-message aui-message-error">
            <p class="title"><strong>$action.text("janitor.fields.deep.failed.title")</strong></p>
            <p>$action.escape($action.deepFailure)</p>
            <p>$action.text("janitor.fields.scanFailed.at") $action.deepFailureAt</p>
            #if ($action.deepResultStale)
                <p><strong>$action.text("janitor.fields.deep.failed.stale")</strong></p>
            #end
        </div>
    #end

    #if ($action.deepResultAvailable)
        <p>$action.text("janitor.fields.deep.summary", $action.deepTableCount, $action.deepRowCount, $action.deepFieldCount)</p>

        #* 건너뛴 테이블을 화면에 낸다. "해석하지 않는다"는 원칙이 굽는 유일한
           자리라 숨기면 표가 완전한 것으로 읽힌다. *#
        #if ($action.deepSkippedPrefixes.size() > 0)
            <p class="janitor-meta">
                $action.text("janitor.fields.deep.skipped")
                #foreach ($prefix in $action.deepSkippedPrefixes)$!{prefix}_* #end
            </p>
        #end

        #if ($action.deepProblems.size() > 0)
            <p class="janitor-meta">$action.text("janitor.fields.deep.problems", $action.deepProblems.size())</p>
            <table class="aui">
                <thead>
                <tr>
                    <th>$action.text("janitor.fields.problems.target")</th>
                    <th>$action.text("janitor.fields.problems.message")</th>
                </tr>
                </thead>
                <tbody>
                #foreach ($problem in $action.deepProblems)
                    <tr>
                        <td>$action.escape($problem.target)</td>
                        <td>$action.escape($problem.message)</td>
                    </tr>
                #end
                </tbody>
            </table>
        #end
    #end
</div>

<script type="text/javascript">
(function () {
    var restBase = "${action.restBase}";
    var langParam = "$action.restLangParam";
    var SESSION_EXPIRED = "$action.escapeJs($action.text('janitor.fields.sessionExpired'))";
    var REQUEST_FAILED = "$action.escapeJs($action.text('janitor.fields.scanRequestFailed'))";
    var OTHER_RUNNING = "$action.escapeJs($action.text('janitor.fields.otherScanRunning'))";

    function request(method, path, done) {
        var xhr = new XMLHttpRequest();
        xhr.open(method, restBase + path + langParam, true);
        xhr.setRequestHeader("Accept", "application/json");
        // 쿠키 인증으로 POST를 보내려면 이 헤더가 필요하다(Jira XSRF 검사).
        xhr.setRequestHeader("X-Atlassian-Token", "no-check");
        xhr.onreadystatechange = function () {
            if (xhr.readyState !== 4) { return; }
            var body = null;
            try { body = JSON.parse(xhr.responseText); } catch (e) { body = null; }
            done(xhr.status, body);
        };
        xhr.send();
    }

    /**
     * 스캔 한 종류의 버튼·진행률 상자·폴링. 일반 스캔과 심층 스캔이 같은 규칙이라 하나를
     * 두 번 만든다 — 전에는 두 벌이었고 한쪽만 고쳐지는 일이 있었다(리뷰 #12).
     *
     * 규칙(전부 실측에서 나온 것):
     * - 401/403 이면 폴링을 멈추고 버튼을 되살리고 이유를 낸다. 이게 없으면 웹수도 세션이
     *   만료된 순간 "눌렀는데 아무 일도 없고 버튼이 죽었다"가 된다. 큰 인스턴스에서는 스캔이
     *   웹수도 제한 시간보다 오래 걸려 실제로 일어난다.
     * - 202=시작, 409=이미 실행 중. 409 인데 RUNNING 이 아니면 막은 것이 "다른" 스캔이다 —
     *   붙을 진행률이 없으니 폴링하지 않고 이유를 낸다. blockedBy 로 판단하지 않는 이유는
     *   잠금이 그 사이 풀리면 null 일 수 있어서다.
     * - 끝나면 새로고침한다(결과는 서버가 그린다). 실패면 새로고침하지 않는다 — 방금 본
     *   실패 메시지가 화면 점프 없이 그 자리에 남는 편이 덜 놀랍다. 실패는 재로드해도 남는다.
     */
    function scanController(cfg) {
        var button = document.getElementById(cfg.buttonId);
        var box = document.getElementById(cfg.boxId);
        var inner = document.getElementById(cfg.boxId + "-box");
        var text = document.getElementById(cfg.boxId + "-text");
        var polling = null;

        function stop() {
            if (polling !== null) {
                window.clearInterval(polling);
                polling = null;
            }
            if (button) { button.removeAttribute("disabled"); }
        }

        function say(kind, message) {
            box.style.display = "";
            inner.className = "aui-message aui-message-" + kind;
            text.textContent = message;
        }

        function showError(code) {
            stop();
            say("error", (code === 401 || code === 403) ? SESSION_EXPIRED : REQUEST_FAILED);
        }

        function showBlocked() {
            say("warning", OTHER_RUNNING);
            if (button) { button.removeAttribute("disabled"); }
        }

        function show(status) {
            if (!status) { return; }
            if (status.state === "RUNNING") {
                say("info", cfg.describe(status));
            } else if (status.state === "FAILED") {
                say("error", status.error || "failed");
            } else {
                say("info", "");
                box.style.display = "none";
            }
        }

        function poll() {
            request("GET", cfg.statusPath, function (code, status) {
                if (code === 401 || code === 403) { showError(code); return; }
                if (code !== 200 || !status) { return; }
                show(status);
                if (status.state !== "RUNNING") {
                    stop();
                    if (status.state === "FAILED") { return; }
                    window.location.reload();
                }
            });
        }

        function attach() {
            if (button) { button.setAttribute("disabled", "disabled"); }
            if (polling === null) {
                polling = window.setInterval(poll, 1500);
            }
        }

        function start() {
            button.setAttribute("disabled", "disabled");
            request("POST", cfg.startPath, function (code, status) {
                if (code >= 400 && code !== 409) { showError(code); return; }
                if (code === 409 && (!status || status.state !== "RUNNING")) { showBlocked(); return; }
                show(status);
                attach();
            });
        }

        if (button) { button.addEventListener("click", start); }
        // 이미 돌고 있으면(다른 창에서 눌렀거나 새로고침) 바로 폴링을 붙인다.
        return { attach: function () { attach(); poll(); } };
    }

    var normalScan = scanController({
        buttonId: "janitor-scan", boxId: "janitor-progress",
        startPath: "/scan", statusPath: "/scan/status",
        describe: function (s) {
            return (s.stageLabel || s.stage || "") + " (" + s.stageIndex + "/" + s.stageTotal + ", " + s.percent + "%)";
        }
    });
    var deepScan = scanController({
        buttonId: "janitor-deep-scan", boxId: "janitor-deep-progress",
        startPath: "/deep/scan", statusPath: "/deep/status",
        describe: function (s) {
            return (s.tableName || "") + " (" + s.tableIndex + "/" + s.tableTotal + ", " + s.percent + "%)";
        }
    });

    #if ($action.deepScanning)
    deepScan.attach();
    #end
    #if ($action.scanning)
    normalScan.attach();
    #end

    // --- 필터 / 정렬 ------------------------------------------------------------
    var table = document.getElementById("janitor-fields");
    if (!table) { return; }
    var tbody = table.querySelector("tbody");
    var rows = Array.prototype.slice.call(tbody.querySelectorAll("tr"));
    var search = document.getElementById("janitor-search");
    var statusFilter = document.getElementById("janitor-status");
    var typeFilter = document.getElementById("janitor-type");
    var counter = document.getElementById("janitor-count");

    function applyFilters() {
        var term = (search.value || "").toLowerCase();
        var wantStatus = statusFilter.value;
        // 드롭다운 값은 목록에 실제로 있는 타입 이름이므로 정확일치로 비교한다.
        var wantType = (typeFilter.value || "").toLowerCase();
        var shown = 0;
        rows.forEach(function (row) {
            var name = (row.getAttribute("data-name") || "").toLowerCase();
            var fieldId = (row.getAttribute("data-fieldid") || "").toLowerCase();
            var type = (row.getAttribute("data-type") || "").toLowerCase();
            var visible = (term === "" || name.indexOf(term) >= 0 || fieldId.indexOf(term) >= 0)
                && (wantStatus === "" || row.getAttribute("data-status") === wantStatus)
                && (wantType === "" || type === wantType);
            row.style.display = visible ? "" : "none";
            if (visible) { shown++; }
        });
        counter.textContent = shown + " / " + rows.length;
    }

    search.addEventListener("input", applyFilters);
    statusFilter.addEventListener("change", applyFilters);
    typeFilter.addEventListener("change", applyFilters);
    applyFilters();

    var sortState = {};
    Array.prototype.slice.call(table.querySelectorAll("th[data-sort]")).forEach(function (header) {
        header.addEventListener("click", function () {
            var key = header.getAttribute("data-sort");
            var ascending = !sortState[key];
            sortState = {};
            sortState[key] = ascending;
            var cellIndex = Array.prototype.indexOf.call(header.parentNode.children, header);
            rows.sort(function (left, right) {
                var a = left.children[cellIndex];
                var b = right.children[cellIndex];
                var av = a.getAttribute("data-sort-value");
                var bv = b.getAttribute("data-sort-value");
                if (av !== null && bv !== null) {
                    return (ascending ? 1 : -1) * (parseFloat(av) - parseFloat(bv));
                }
                return (ascending ? 1 : -1) *
                    a.textContent.trim().toLowerCase().localeCompare(b.textContent.trim().toLowerCase());
            });
            rows.forEach(function (row) { tbody.appendChild(row); });
        });
    });
})();
</script>

</body>
</html>
